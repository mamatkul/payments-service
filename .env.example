API_KEY=change-me-to-a-long-random-key

LOG_LEVEL=INFO

POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=100

MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1
WEBHOOK_TIMEOUT_SECONDS=5

GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9
